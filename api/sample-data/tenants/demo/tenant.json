{
  // Sample tenant used for local development (npm run dev + dotnet run).
  "name": "Max Mustermann (demo)",
  // Hosts that open this tenant without an invite code. "localhost" makes local dev work out of the box.
  "hosts": ["localhost"],
  "defaultLocale": "en",
  // Profile shown on the hosts above without a (valid) invite. Omit or set null to require an invite.
  "publicProfile": "public",
  // Templates of this person (see docs/TEMPLATES.md); profiles and invites may override them.
  "templates": { "pdf": "editorial" },
  "profiles": {
    "public": {
      "flags": {
        "hideCompanies": true,
        "hideTimeframeMonths": true,
        "hidePhoto": true,
        "hideContactDetails": true,
        "hideBirthDate": true
      },
      "hiddenFields": ["projects", "details.citizenship"]
    },
    "recruiter": {
      "grants": ["contact"],
      "templates": { "pdf": "classic" },
      "flags": { "hideTimeframeDays": true, "hideBirthDate": true }
    },
    "full": {
      "grants": ["contact", "private"]
    }
  }
}
