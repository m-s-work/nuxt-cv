{
  // Tenant without own hostname: only reachable on the shared host via invite (?c=...).
  "name": "Bob Builder",
  "hosts": [],
  "defaultLocale": "en",
  "favicon": { "symbol": "terminal", "color": "green" },
  // Visitor tracking (docs/VISITOR_SESSION_TRACKING.md): shown in the consent modal. Without a controller nothing is tracked.
  "privacy": { "controller": "Bob Builder", "contact": "privacy@bob-builder.example" },
  // Tracking defaults: on unless a profile or invite switches it off ("tracking": { "enabled": false }).
  "tracking": { "enabled": true, "retention": { "identifiersMonths": 13, "summaryMonths": 25 } },
  "profiles": {
    // No consent modal and no tracking for this profile (invites may switch it on again).
    "anonymous": { "flags": { "hideCompanies": true, "hideContactDetails": true }, "tracking": { "enabled": false } },
    "full": { "grants": ["contact"] }
  }
}
